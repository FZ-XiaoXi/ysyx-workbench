diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..326ec967 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -8,9 +8,9 @@ module apb_delayer(
   input         in_pwrite,
   input  [31:0] in_pwdata,
   input  [3:0]  in_pstrb,
-  output        in_pready,
-  output [31:0] in_prdata,
-  output        in_pslverr,
+  output reg       in_pready,
+  output reg[31:0] in_prdata,
+  output reg       in_pslverr,
 
   output [31:0] out_paddr,
   output        out_psel,
@@ -31,8 +31,108 @@ module apb_delayer(
   assign out_pwrite  = in_pwrite;
   assign out_pwdata  = in_pwdata;
   assign out_pstrb   = in_pstrb;
-  assign in_pready   = out_pready;
-  assign in_prdata   = out_prdata;
-  assign in_pslverr  = out_pslverr;
 
+  reg [1:0] state,next_state;
+  reg [31:0] cnt;
+  parameter S_IDLE  = 2'b00;
+  parameter S_WAIT  = 2'b01;
+  parameter S_DELAY = 2'b10;
+
+  always @(posedge clock or posedge reset) begin
+    if (reset) begin
+      state <= S_IDLE;
+    end else begin
+      state <= next_state;
+    end
+  end
+
+
+  // wire [31:0]s = 32'd2;
+  // wire [31:0]k = 32'd3;
+  // wire [31:0]sk = (k - 32'd1) * s;
+  wire [31:0]s = 32'd1;
+  wire [31:0]sk = 32'd1;
+
+
+  always @(posedge clock or posedge reset) begin
+    if (reset) begin
+      cnt <= 32'b0;
+    end else begin
+      if(state == S_IDLE && next_state == S_WAIT) begin
+        cnt <= sk;
+      end else if(state == S_WAIT && next_state == S_WAIT) begin
+        cnt <= cnt + sk;
+      // end else if(state == S_WAIT && next_state == S_DELAY) begin
+      //   cnt <= 32'd5 - 32'd1;
+      end else if(state == S_DELAY || next_state == S_DELAY) begin
+        cnt <= cnt - s;
+      end else begin
+        cnt <= 32'd0;
+      end
+    end
+  end
+
+  always @(*) begin
+    case (state)
+      S_IDLE: begin
+       if(in_psel && ~in_penable) begin
+          next_state = S_WAIT;
+        end else begin
+          next_state = S_IDLE;
+        end
+      end
+      S_WAIT: begin
+        if(out_pready) begin
+          next_state = S_DELAY;
+        end else begin
+          next_state = S_WAIT;
+        end
+      end
+      S_DELAY: begin
+        if(cnt == 32'd0) begin
+          next_state = S_IDLE;
+        end else begin
+          next_state = S_DELAY;
+        end
+      end
+      default: begin
+        next_state = S_IDLE;
+      end
+    endcase
+  end
+
+
+  always @(*) begin
+    if(state == S_DELAY && next_state == S_IDLE) begin
+      in_pready  = pready_reg;
+      in_prdata  = prdata_reg;
+      in_pslverr = pslverr_reg;
+    end else begin
+      in_pready  = 1'b0;
+      in_prdata  = 32'hdeaddead;
+      in_pslverr = 1'b0;
+    end
+  end
+
+  reg [31:0] prdata_reg;
+  reg        pslverr_reg;
+  reg        pready_reg;
+
+  always @(posedge clock or posedge reset) begin
+    if (reset) begin
+      prdata_reg  <= 32'b0;
+      pslverr_reg <= 1'b0;
+      pready_reg  <= 1'b0;
+    end else begin
+      if(state == S_WAIT && next_state == S_DELAY) begin
+        prdata_reg  <= out_prdata;
+        pslverr_reg <= out_pslverr;
+        pready_reg  <= out_pready;
+      end else begin
+        prdata_reg  <= prdata_reg;
+        pslverr_reg <= pslverr_reg;
+        pready_reg  <= pready_reg;
+      end
+    end
+  end
 endmodule
diff --git a/perip/flash/flash.v b/perip/flash/flash.v
index 480d7092..407d19fd 100644
--- a/perip/flash/flash.v
+++ b/perip/flash/flash.v
@@ -11,7 +11,10 @@ module flash (
 );
   wire reset = ss;
 
-  typedef enum [2:0] { cmd_t, addr_t, data_t, err_t } state_t;
+  parameter cmd_t  = 3'd0;
+  parameter addr_t = 3'd1;
+  parameter data_t = 3'd2;
+  parameter err_t = 3'd3;
   reg [2:0]  state;
   reg [7:0]  counter;
   reg [7:0]  cmd;
@@ -73,11 +76,11 @@ module flash (
   always@(posedge sck or posedge reset) begin
     if (reset) data <= 32'd0;
     else if (state == data_t) begin
-      data <= { {counter == 8'd0 ? data_bswap : data}[30:0], 1'b0 };
+      data <= { (counter == 8'd0 ? data_bswap[30:0] : data[30:0]), 1'b0 };
     end
   end
 
-  assign miso = ss ? 1'b1 : ({(state == data_t && counter == 8'd0) ? data_bswap : data}[31]);
+  assign miso = ss ? 1'b1 : ({(state == data_t && counter == 8'd0) ? data_bswap[31] : data[31]});
 
 endmodule
 
@@ -91,11 +94,13 @@ module flash_cmd(
   output reg [31:0] data
 );
   always@(posedge clock) begin
-    if (valid)
-      if (cmd == 8'h03) flash_read(addr, data);
-      else begin
+    if (valid) begin
+      if (cmd == 8'h03) begin
+        flash_read(addr, data);
+      end else begin
         $fwrite(32'h80000002, "Assertion failed: Unsupport command `%xh`, only support `03h` read command\n", cmd);
         $fatal;
       end
+    end
   end
 endmodule
