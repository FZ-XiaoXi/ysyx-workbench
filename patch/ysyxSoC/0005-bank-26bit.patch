 );
diff --git a/perip/sdram/core_sdram_axi4/sdram_axi_core.v b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
index 425fba2f..271c8bb8 100644
--- a/perip/sdram/core_sdram_axi4/sdram_axi_core.v
+++ b/perip/sdram/core_sdram_axi4/sdram_axi_core.v
@@ -57,7 +57,7 @@ module sdram_axi_core
     ,output          sdram_we_o
     ,output [  3:0]  sdram_dqm_o
     ,output [ 12:0]  sdram_addr_o
-    ,output [  1:0]  sdram_ba_o
+    ,output [  2:0]  sdram_ba_o
     ,output [ 31:0]  sdram_data_output_o
     ,output          sdram_data_out_en_o
 );
@@ -68,17 +68,17 @@ module sdram_axi_core
 // Key Params
 //-----------------------------------------------------------------
 parameter SDRAM_MHZ              = 50;
-parameter SDRAM_ADDR_W           = 24;
+parameter SDRAM_ADDR_W           = 26;
 parameter SDRAM_COL_W            = 9;
 parameter SDRAM_READ_LATENCY     = 1;
 
 //-----------------------------------------------------------------
 // Defines / Local params
 //-----------------------------------------------------------------
-localparam SDRAM_BANK_W          = 2;
+localparam SDRAM_BANK_W          = 3;
 localparam SDRAM_DQM_W           = 4;
 localparam SDRAM_BANKS           = 2 ** SDRAM_BANK_W;
-localparam SDRAM_ROW_W           = SDRAM_ADDR_W - SDRAM_COL_W - SDRAM_BANK_W;
+localparam SDRAM_ROW_W           = SDRAM_ADDR_W - SDRAM_COL_W - SDRAM_BANK_W - 1;   //13  
 localparam SDRAM_REFRESH_CNT     = 2 ** SDRAM_ROW_W;
 localparam SDRAM_START_DELAY     = 100000 / (1000 / SDRAM_MHZ); // 100uS
 localparam SDRAM_REFRESH_CYCLES  = (64000*SDRAM_MHZ) / SDRAM_REFRESH_CNT-1;
@@ -177,8 +177,8 @@ reg  [STATE_W-1:0]     delay_state_q;
 
 // Address bits
 wire [SDRAM_ROW_W-1:0]  addr_col_w  = {{(SDRAM_ROW_W-SDRAM_COL_W){1'b0}}, ram_addr_w[SDRAM_COL_W+1:2]};
-wire [SDRAM_ROW_W-1:0]  addr_row_w  = {ram_addr_w[SDRAM_ADDR_W+1:SDRAM_COL_W+2+1+1]};
-wire [SDRAM_BANK_W-1:0] addr_bank_w = ram_addr_w[SDRAM_COL_W+2+1:SDRAM_COL_W+2-1+1];
+wire [SDRAM_ROW_W-1:0]  addr_row_w  = {ram_addr_w[SDRAM_ADDR_W:SDRAM_COL_W+5]};
+wire [SDRAM_BANK_W-1:0] addr_bank_w = ram_addr_w[SDRAM_COL_W+4:SDRAM_COL_W+2];
 
 //-----------------------------------------------------------------
 // SDRAM State Machine
diff --git a/perip/sdram/sdram.v b/perip/sdram/sdram.v
index db8c65e5..269b27eb 100644
--- a/perip/sdram/sdram.v
+++ b/perip/sdram/sdram.v
@@ -1,5 +1,5 @@
-import "DPI-C" function void sdram_write(input int waddr, input int count, input int wdata , input sel);
-import "DPI-C" function void sdram_read (input int raddr, input int count, output int rdata , input sel);
+import "DPI-C" function void sdram_write(input int waddr, input int count, input int wdata , input int sel);
+import "DPI-C" function void sdram_read (input int raddr, input int count, output int rdata , input int sel);
 
 module sdram(
   input        clk,
@@ -9,10 +9,86 @@ module sdram(
   input        cas,
   input        we,
   input [12:0] a,
-  input [ 1:0] ba,
+  input [ 2:0] ba,
   input [ 3:0] dqm,
   inout [31:0] dq
 );
+  wire clock;
+  assign clock = clk & cke;
+
+  // dq shared by both sdram_32 instances — internal tri-state in sdram_16
+  // ensures only the active chip drives the bus; deselected chip outputs Z.
+
+  parameter M_MODE   = 3'b000;
+  parameter M_ACTIVE = 3'b011;
+  parameter M_WRITE =  3'b100;
+  parameter M_READ  =  3'b101;
+
+  wire [2:0] comm;
+  wire comm_active;
+  assign comm = {ras,cas,we};
+  assign comm_active = ~cs&((comm==M_ACTIVE) || (comm==M_WRITE) || (comm==M_READ));
+  
+  
+  wire now_sel;
+  reg [2:0]reg_ba;
+  assign now_sel = comm_active?ba[2]:reg_ba[2];
+  wire cs0,cs1;
+  assign cs0 = (now_sel==1'b0 || M_MODE==comm)?cs:1'b1;
+  assign cs1 = (now_sel==1'b1 || M_MODE==comm)?cs:1'b1;
+
+  always @(posedge clock) begin
+    if(comm_active)
+      reg_ba <= ba;
+    else
+      reg_ba <= reg_ba;
+  end
+  
+  
+  sdram_32 sdram_32_0(
+    .clk(clk),
+    .cke(cke),
+    .cs(cs0),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba[1:0]),
+    .dqm(dqm),
+    .dq(dq),
+    .sel(1'b0)
+  );
+
+  sdram_32 sdram_32_1(
+    .clk(clk),
+    .cke(cke),
+    .cs(cs1),
+    .ras(ras),
+    .cas(cas),
+    .we(we),
+    .a(a),
+    .ba(ba[1:0]),
+    .dqm(dqm),
+    .dq(dq),
+    .sel(1'b1)
+  );
+
+endmodule
+
+
+module sdram_32(
+  input        clk,
+  input        cke,
+  input        cs,
+  input        ras,
+  input        cas,
+  input        we,
+  input [12:0] a,
+  input [ 1:0] ba,
+  input [ 3:0] dqm,
+  inout [31:0] dq,
+  input sel
+);
 
 
 
@@ -27,7 +103,7 @@ module sdram(
     .ba(ba),
     .dqm(dqm[1:0]),
     .dq(dq[15:0]),
-    .sel(1'b0)
+    .sel({sel,1'b0})
   );
   sdram_16 u_sdram_16_H(
     .clk(clk),
@@ -40,7 +116,7 @@ module sdram(
     .ba(ba),
     .dqm(dqm[3:2]),
     .dq(dq[31:16]),
-    .sel(1'b1)
+    .sel({sel,1'b1})
   );
 
 endmodule
@@ -57,7 +133,7 @@ module sdram_16(
   input [ 1:0] ba,
   input [ 1:0] dqm,
   inout [15:0] dq,
-  input        sel
+  input [ 1:0] sel
 );
 
   reg  [12:0] reg_active_row[0:3];
@@ -80,7 +156,7 @@ module sdram_16(
 
 
   wire clock;
-  assign clock = clk & cke;
+  assign clock = clk & cke & ~cs;
   assign dq = (wire_dq_out_en)?wire_dq_out:16'bz;
 
   assign wire_command = {ras,cas,we};
@@ -155,7 +231,7 @@ module sdram_16(
           next_state = S_READ;
         end
         S_READ: begin
-          if(count == ((mode_BL==1)?4'd0:(mode_BL==1)?4'd1:(mode_BL==2)?4'd3:(mode_BL==3)?4'd7:4'd1))begin
+          if(count == ((mode_BL==0)?4'd0:(mode_BL==1)?4'd1:(mode_BL==2)?4'd3:(mode_BL==3)?4'd7:4'd1))begin
             next_state = S_IDLE;
           end else begin
             next_state = S_READ;
@@ -207,9 +283,9 @@ module sdram_16(
       end
 
       if(state==S_IDLE && wire_command==M_WRITE) begin
-        sdram_write(wire_addr, {28'b0,count}, {~dqm,14'b0,dq},sel);
+        sdram_write(wire_addr, {28'b0,count}, {~dqm,14'b0,dq},{30'b0,sel});
       end else if(state==S_WRITE) begin
-        sdram_write(reg_active_addr, {28'b0,count}, {~dqm,14'b0,dq},sel);
+        sdram_write(reg_active_addr, {28'b0,count}, {~dqm,14'b0,dq},{30'b0,sel});
       end
 
       // if(state==S_RCAS && next_state!=S_RCAS) begin
@@ -223,7 +299,7 @@ module sdram_16(
   reg [31:0] sdram_rdata;
   assign wire_dq_out = sdram_rdata[15:0];
   always@(*)begin
-    sdram_read(reg_active_addr,{28'b0,count},sdram_rdata,sel);
+    sdram_read(reg_active_addr,{28'b0,count},sdram_rdata,{30'b0,sel});
   end
 
   always @(*) begin
