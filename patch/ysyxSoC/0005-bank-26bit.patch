@@ -48,7 +48,7 @@ module sdram_top_axi(
   assign sdram_dq = sdram_dout_en ? sdram_dout : 16'bz;
   sdram_axi #(
     .SDRAM_MHZ(100),
-    .SDRAM_ADDR_W(24),
