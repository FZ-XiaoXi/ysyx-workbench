---
 perip/amba/apb_delayer.v | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index 326ec967..297020be 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -50,8 +50,8 @@ module apb_delayer(
   // wire [31:0]s = 32'd2;
   // wire [31:0]k = 32'd3;
   // wire [31:0]sk = (k - 32'd1) * s;
-  wire [31:0]s = 32'd1;
-  wire [31:0]sk = 32'd1;
+  wire [31:0]s = 32'd20;
+  wire [31:0]sk = 32'd49;
 
 
   always @(posedge clock or posedge reset) begin
@@ -89,7 +89,7 @@ module apb_delayer(
         end
       end
       S_DELAY: begin
-        if(cnt == 32'd0) begin
+        if(cnt < s) begin
           next_state = S_IDLE;
         end else begin
           next_state = S_DELAY;
