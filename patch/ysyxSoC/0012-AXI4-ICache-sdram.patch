---
 perip/sdram/sdram.v         | 8 ++++++--
 perip/sdram/sdram_top_axi.v | 5 +++--
 src/Top.scala               | 2 +-
 3 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/perip/sdram/sdram.v b/perip/sdram/sdram.v
index fb787848..917d1154 100644
--- a/perip/sdram/sdram.v
+++ b/perip/sdram/sdram.v
@@ -232,7 +232,11 @@ module sdram_16(
         end
         S_READ: begin
           if(count == ((mode_BL==0)?4'd0:(mode_BL==1)?4'd1:(mode_BL==2)?4'd3:(mode_BL==3)?4'd7:4'd1))begin
-            next_state = S_IDLE;
+            if(wire_command==M_READ)begin
+              next_state = S_RCAS;
+            end else begin
+              next_state = S_IDLE;
+            end
           end else begin
             next_state = S_READ;
           end
@@ -276,7 +280,7 @@ module sdram_16(
         // reg_active_row <= reg_active_row;
       end
 
-      if(state==S_IDLE && (wire_command==M_WRITE || wire_command==M_READ)) begin
+      if((wire_command==M_WRITE || wire_command==M_READ)) begin //////////////////////////TODO 地址处理还不太对 手册P51
         reg_active_addr <= wire_addr;
       end else begin
         reg_active_addr <= reg_active_addr;
diff --git a/perip/sdram/sdram_top_axi.v b/perip/sdram/sdram_top_axi.v
index 3243ce2b..553d5183 100644
--- a/perip/sdram/sdram_top_axi.v
+++ b/perip/sdram/sdram_top_axi.v
@@ -44,8 +44,9 @@ module sdram_top_axi(
 );
 
   wire sdram_dout_en;
-  wire [15:0] sdram_dout;
-  assign sdram_dq = sdram_dout_en ? sdram_dout : 16'bz;
+  wire [31:0] sdram_dout;
+  assign sdram_dq = sdram_dout_en ? sdram_dout : 32'bz;
+
   sdram_axi #(
     .SDRAM_MHZ(100),
     .SDRAM_ADDR_W(26),
diff --git a/src/Top.scala b/src/Top.scala
index c3bcd72b..864d433b 100644
--- a/src/Top.scala
+++ b/src/Top.scala
@@ -7,7 +7,7 @@ import freechips.rocketchip.diplomacy.LazyModule
 
 object Config {
   def hasChipLink: Boolean = false
-  def sdramUseAXI: Boolean = false
+  def sdramUseAXI: Boolean = true
 }
 
 class ysyxSoCTop extends Module {
