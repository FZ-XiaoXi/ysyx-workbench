 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index 55757dfc..0901ae7e 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -50,8 +50,8 @@ module apb_delayer(
   // wire [31:0]s = 32'd2;
   // wire [31:0]k = 32'd3;
   // wire [31:0]sk = (k - 32'd1) * s;
-  wire [31:0]s = 32'd1;
-  wire [31:0]sk = 32'd6;
+  wire [31:0]s = 32'd50;
+  wire [31:0]sk = 32'd293;
 
 
   always @(posedge clock or posedge reset) begin
diff --git a/perip/amba/axi4_delayer.v b/perip/amba/axi4_delayer.v
index c7346a54..3daf5549 100644
