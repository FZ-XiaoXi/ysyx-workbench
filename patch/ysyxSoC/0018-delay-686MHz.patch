@@ -66,8 +66,8 @@ module axi4_delayer(
   parameter S_WAIT  = 2'b01;
   parameter S_DELAY = 2'b10;
   parameter S_DONE = 2'b11;
-  parameter [31:0]s = 32'd1;
-  parameter [31:0]sk = 32'd6;
+  parameter [31:0]s = 32'd50;
+  parameter [31:0]sk = 32'd293;
   //RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
 
 
@@ -361,8 +361,8 @@ module axi_read_delayer_single(
   parameter S_WAIT  = 2'b01;
   parameter S_DELAY = 2'b10;
   parameter S_DONE  = 2'b11;
-  parameter [31:0]s = 32'd1;
-  parameter [31:0]sk = 32'd6;
+  parameter [31:0]s = 32'd50;
+  parameter [31:0]sk = 32'd293;
   // assign in_rvalid = out_rvalid;
   // assign in_rid = out_rid;
   // assign in_rdata = out_rdata;
