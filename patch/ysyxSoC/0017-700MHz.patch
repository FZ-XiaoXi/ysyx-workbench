   parameter S_DELAY = 2'b10;
   parameter S_DONE = 2'b11;
   parameter [31:0]s = 32'd1;
-  parameter [31:0]sk = 32'd9;
+  parameter [31:0]sk = 32'd6;
   //RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
 
 
@@ -362,7 +362,7 @@ module axi_read_delayer_single(
   parameter S_DELAY = 2'b10;
   parameter S_DONE  = 2'b11;
   parameter [31:0]s = 32'd1;
-  parameter [31:0]sk = 32'd9;
+  parameter [31:0]sk = 32'd6;
